<configuration>
    <include
            resource="/org/springframework/boot/logging/logback/base.xml" />
    <appender name="BASE_FILE" class="ch.qos.logback.core.FileAppender">
        <file>/tmp/beelife.log</file>
        <encoder>
            <pattern>%date %level [%thread] %logger{10} [%file:%line] %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="EROR_FILE" class="ch.qos.logback.core.FileAppender">
        <file>/tmp/beelife_error.log</file>
        <encoder>
            <pattern>%date %level [%thread] %logger{10} [%file:%line] %msg%n</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="BASE_FILE"/>
        <appender-ref ref="EROR_FILE" />
    </root>
</configuration>